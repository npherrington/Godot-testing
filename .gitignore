# Godot
.godot/
*.import
# godot-mcp-runtime's bridge and screenshots
.mcp/
# tools installed by bin/setup.sh
tools/node_modules/
tools/.venv/
# per-run logs, plans, evidence (keep the .gdignore so Godot skips the folder)
runs/*
!runs/.gdignore
.DS_Store

# art previews and audio intermediates (art/build.py, art/audio/build_audio.py)
art/out/
__pycache__/
